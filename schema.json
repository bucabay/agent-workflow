{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./schema.json",
  "title": "AWL - Agent Workflow Language",
  "description": "Indented, state-machine workflow DSL for agent teams. Semantics inherit from the Amazon States Language (Choice/Parallel/Map/Retry); extended with agent routing, OTel-aligned telemetry, evidence traceability and cost estimation hooks. Indented indentation is purely visual; meaning is structural.",
  "type": "object",
  "required": ["format", "version", "name", "models", "agents", "start", "states"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "awl" },
    "version": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "meta": { "$ref": "#/$defs/meta" },
    "models": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/modelDef" }
    },
    "agents": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/agentDef" }
    },
    "telemetry": { "$ref": "#/$defs/telemetry" },
    "subflows": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/machine" }
    },
    "start": { "type": "string" },
    "states": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/stateAll" }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "string" },
        "source": { "type": "string" },
        "estimate": {
          "type": "object",
          "properties": {
            "pricesFrom": { "type": "string" },
            "perState": { "type": "string" },
            "budgetUsd": { "type": "number", "minimum": 0 },
            "refit": { "type": "boolean" }
          },
          "required": ["pricesFrom", "perState"]
        }
      }
    },
    "modelDef": {
      "type": "object",
      "required": ["provider", "model"],
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "usdPerMillionInput": { "type": "number", "minimum": 0 },
        "usdPerMillionOutput": { "type": "number", "minimum": 0 },
        "role": { "type": "string" }
      }
    },
    "agentDef": {
      "type": "object",
      "required": ["model"],
      "properties": {
        "model": { "type": "string" },
        "readOnly": { "type": "boolean" },
        "cleanContext": { "type": "boolean" },
        "tools": { "type": "array", "items": { "type": "string" } },
        "prompt": { "type": "string" },
        "maxTurns": { "type": "integer", "minimum": 1 },
        "optional": {
          "description": "Best-effort agent: the runtime may omit it (unavailable, not configured, or unnecessary) instead of failing the task that uses it.",
          "type": "boolean",
          "default": false
        },
        "sidekicks": {
          "description": "Delegation hierarchy this agent owns while it runs. Each name is another agentDef, which may itself declare sidekicks (arbitrary nesting). Runtime must reject cycles.",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "agentRef": {
      "type": "object",
      "required": ["agent"],
      "properties": {
        "agent": { "type": "string" },
        "when": { "oneOf": [ { "$ref": "#/$defs/condition" }, { "$ref": "#/$defs/answerWhen" } ] },
        "args": { "type": "object" },
        "optional": {
          "description": "This candidate may be skipped if inapplicable or unavailable.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "agentSelector": {
      "description": "Per-state agent routing. pick-one: exactly one matching candidate runs (a candidate with no 'when' always matches and acts as the default). run-all: every matching candidate runs and outputs are combined. An empty yield is an error unless the task state or a candidate is optional. An optional 'decision' grounds the routing in research/guidelines via an LLM or Jev-style decider.",
      "type": "object",
      "required": ["candidates"],
      "properties": {
        "mode": { "enum": ["pick-one", "run-all"], "default": "pick-one" },
        "pick": {
          "description": "pick-one strategy: first matching in declaration order, cheapest matching by resolved model price, or first matching available at runtime.",
          "enum": ["first", "cheapest", "available"],
          "default": "first"
        },
        "combine": { "type": "string", "default": "merge" },
        "decision": { "$ref": "#/$defs/decision" },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/agentRef" }
        }
      }
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "conventions": { "type": "string" },
        "operationName": { "type": "string" },
        "record": { "type": "array", "items": { "type": "string" } },
        "rating": {
          "type": "object",
          "properties": {
            "scale": { "type": "array", "items": { "type": "integer" } },
            "labels": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "required": ["conventions", "record"]
    },
    "machine": {
      "type": "object",
      "required": ["start", "states"],
      "properties": {
        "start": { "type": "string" },
        "states": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/stateAll" }
        }
      }
    },
    "condition": {
      "type": "object",
      "required": ["path", "op"],
      "properties": {
        "path": { "type": "string" },
        "op": { "enum": ["equals", "notEquals", "gt", "gte", "lt", "lte", "contains", "exists"] },
        "value": {}
      }
    },
    "answerWhen": {
      "description": "A branch condition on a decision's answer (Jev-compatible). 'equals' matches a choice label; numeric ops match a noul probability or a score band; minConfidence guards on the answer's confidence.",
      "type": "object",
      "required": ["question"],
      "properties": {
        "question": { "type": "string" },
        "equals": {},
        "lt": { "type": "number" },
        "lte": { "type": "number" },
        "gt": { "type": "number" },
        "gte": { "type": "number" },
        "minConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "anyOf": [
        { "required": ["equals"] },
        { "required": ["lt"] },
        { "required": ["lte"] },
        { "required": ["gt"] },
        { "required": ["gte"] }
      ]
    },
    "question": {
      "description": "A typed judgment in the Jev shape. 'instructions' is the full prompt surface and may be a large body of text (string) or structured (object/array); 'criteria' define the possible answers.",
      "type": "object",
      "required": ["type", "instructions"],
      "properties": {
        "type": { "enum": ["choice", "score", "noul"] },
        "instructions": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": {} },
            { "type": "object" }
          ]
        },
        "criteria": {}
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "choice" } }, "required": ["type"] },
          "then": {
            "required": ["criteria"],
            "properties": { "criteria": { "type": "object" } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "score" } }, "required": ["type"] },
          "then": {
            "required": ["criteria"],
            "properties": { "criteria": { "type": "array", "minItems": 2, "items": {} } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "noul" } }, "required": ["type"] },
          "then": {
            "properties": {
              "criteria": {
                "type": "object",
                "properties": { "true": {}, "false": {} }
              }
            }
          }
        }
      ]
    },
    "decision": {
      "description": "A research-and-guideline-grounded judgment evaluated outside the workflow by an LLM agent or a Jev-style calibrated decision model. Answers use Jev-compatible question types; branches route on answers with optional confidence thresholds.",
      "type": "object",
      "required": ["context", "questions"],
      "properties": {
        "decider": {
          "type": "object",
          "required": ["engine"],
          "properties": {
            "engine": { "enum": ["llm", "jev"] },
            "agent": { "description": "engine 'llm' only: the named agent that answers the questions.", "type": "string" },
            "model": { "description": "engine 'jev' only: a Jev-style model identifier (e.g. jev-latest).", "type": "string" }
          }
        },
        "context": {
          "description": "The body of evidence every decider must read before answering: the specific research and the caller's guidelines. For a Jev decider this folds into 'state'.",
          "type": "object",
          "properties": {
            "research": { "type": "array", "items": { "type": "string" } },
            "guidelines": { "type": "array", "items": { "type": "string" } },
            "input": {
              "description": "Path(s) into the workflow state folded into the evaluated state.",
              "oneOf": [ { "type": "string" }, { "type": "array", "items": { "type": "string" } } ]
            }
          },
          "additionalProperties": true
        },
        "questions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/question" }
        },
        "confidence": {
          "description": "Default minimum confidence for evaluable branches when the branch does not set one.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "guard": {
      "type": "object",
      "properties": {
        "maxIterations": { "type": "integer", "minimum": 1 },
        "exhaustNext": { "type": "string" }
      },
      "required": ["maxIterations", "exhaustNext"]
    },
    "common": {
      "properties": {
        "type": { "type": "string" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "finding"],
            "properties": {
              "source": { "type": "string" },
              "finding": { "type": "string" }
            }
          }
        },
        "metrics": {
          "type": "object",
          "properties": {
            "emit": { "type": "boolean" },
            "capture": { "type": "array", "items": { "type": "string" } }
          }
        },
        "expectedTokens": {
          "type": "object",
          "properties": {
            "input": { "type": "integer", "minimum": 0 },
            "output": { "type": "integer", "minimum": 0 }
          }
        },
        "end": { "type": "boolean" }
      }
    },
    "retry": {
      "type": "object",
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1 },
        "backoffMs": { "type": "integer", "minimum": 0 },
        "onExhaust": { "type": "string" }
      },
      "required": ["maxAttempts"]
    },
    "taskState": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["type", "kind"],
          "properties": {
            "type": { "const": "task" },
            "kind": { "enum": ["llm", "tool"], "default": "llm" },
            "agent": { "type": "string" },
            "agents": { "$ref": "#/$defs/agentSelector" },
            "optional": {
              "description": "Whole-state best-effort: if agent selection yields nothing, skip to 'next' instead of failing.",
              "type": "boolean",
              "default": false
            },
            "prompt": { "type": "string" },
            "context": { "type": "object" },
            "artifact": { "type": "object" },
            "run": { "type": "object" },
            "retry": { "$ref": "#/$defs/retry" },
            "next": { "type": "string" },
            "onFail": { "type": "string" }
          },
          "allOf": [
            { "not": { "required": ["agent", "agents"] } },
            {
              "if": { "properties": { "kind": { "const": "llm" } }, "required": ["kind"] },
              "then": { "anyOf": [ { "required": ["agent"] }, { "required": ["agents"] } ] }
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "choiceState": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["type", "branches", "default"],
          "properties": {
            "type": { "const": "choice" },
            "branches": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["when", "next"],
                "properties": {
                  "when": { "oneOf": [ { "$ref": "#/$defs/condition" }, { "$ref": "#/$defs/answerWhen" } ] },
                  "next": { "type": "string" },
                  "label": { "type": "string" }
                }
              }
            },
            "default": { "type": "string" },
            "guard": { "$ref": "#/$defs/guard" },
            "decision": { "$ref": "#/$defs/decision" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "parallelState": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["type", "branches", "next"],
          "properties": {
            "type": { "const": "parallel" },
            "completion": { "enum": ["all", "any"], "default": "all" },
            "branches": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["flow"],
                "properties": {
                  "label": { "type": "string" },
                  "flow": { "type": "string" },
                  "args": { "type": "object" }
                }
              }
            },
            "next": { "type": "string" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "mapState": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["type", "items", "flow", "next"],
          "properties": {
            "type": { "const": "map" },
            "items": { "type": "object" },
            "flow": { "type": "string" },
            "concurrency": { "type": "integer", "minimum": 1 },
            "maxIterations": { "type": "integer", "minimum": 1 },
            "next": { "type": "string" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "callState": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["type", "flow", "next"],
          "properties": {
            "type": { "const": "call" },
            "flow": { "type": "string" },
            "args": { "type": "object" },
            "next": { "type": "string" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "approvalState": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["type", "prompt", "nextOnApprove"],
          "properties": {
            "type": { "const": "approval" },
            "prompt": { "type": "string" },
            "nextOnApprove": { "type": "string" },
            "nextOnReject": { "type": "string" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "passState": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["type", "next"],
          "properties": {
            "type": { "const": "pass" },
            "assign": { "type": "object" },
            "next": { "type": "string" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "succeedState": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "succeed" } }
        }
      ],
      "unevaluatedProperties": false
    },
    "failState": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "fail" },
            "error": { "type": "string" },
            "cause": { "type": "string" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "stateAll": {
      "oneOf": [
        { "$ref": "#/$defs/taskState" },
        { "$ref": "#/$defs/choiceState" },
        { "$ref": "#/$defs/parallelState" },
        { "$ref": "#/$defs/mapState" },
        { "$ref": "#/$defs/callState" },
        { "$ref": "#/$defs/approvalState" },
        { "$ref": "#/$defs/passState" },
        { "$ref": "#/$defs/succeedState" },
        { "$ref": "#/$defs/failState" }
      ]
    }
  }
}